<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">#F3F8FC</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/app_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">#F3F8FC</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">#F3F8FC</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F3F8FC</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
    </style>
</resources>
